{
  "name": "trustci",
  "version": "0.2.0",
  "description": "Bulk-register npm Trusted Publishers (npm trust) across all public packages in a monorepo. Supports GitHub, GitLab and CircleCI.",
  "type": "module",
  "bin": {
    "trustci": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.14.0",
    "npm": ">=11.15.0"
  },
  "scripts": {
    "build": "bun build src/cli.ts --target node --outfile dist/cli.js",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "bun run build",
    "prepare": "husky"
  },
  "keywords": [
    "npm",
    "trusted-publishing",
    "trusted-publisher",
    "oidc",
    "monorepo",
    "cli",
    "npm-trust",
    "github-actions",
    "gitlab",
    "circleci"
  ],
  "author": {
    "name": "Hidetaka Okamoto",
    "url": "https://github.com/hideokamoto"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hideokamoto/trustci.git"
  },
  "homepage": "https://github.com/hideokamoto/trustci#readme",
  "bugs": {
    "url": "https://github.com/hideokamoto/trustci/issues"
  },
  "license": "MIT",
  "packageManager": "bun@1.4.2",
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@types/bun": "1.4.2",
    "husky": "^9.1.7",
    "typescript": "^5"
  }
}
